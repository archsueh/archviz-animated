{
  "skill_md": "SKILL.md",
  "skill_md_max_bytes": 11000,
  "require_lf_pin": true,
  "version": {
    "changelog": "CHANGELOG.md"
  },
  "registries": {
    "modes": {
      "kind": "source_regex",
      "file": "SKILL.md",
      "entry": "^## \\[[678]\\]\\s*(.+?)\\s*$",
      "flags": "M"
    }
  },
  "routing": {
    "registries": [
      "modes"
    ],
    "also_check_triggers": false
  },
  "counts": [
    {
      "id": "modes",
      "truth": {
        "kind": "registry_len",
        "registry": "modes"
      },
      "assertions": [
        {
          "file": "SKILL.md",
          "regex": "(\\d+)\\s*模式："
        }
      ]
    }
  ],
  "coverage": [
    {
      "id": "reference_index",
      "indexed_in": "SKILL.md",
      "globs": [
        "references/**/*.md"
      ]
    }
  ],
  "deps": {
    "requirements": "requirements.txt",
    "python_roots": [
      "scripts"
    ],
    "self_packages": [],
    "map": {
      "PIL": "Pillow"
    }
  },
  "pycompile": {
    "globs": [
      "**/*.py"
    ]
  },
  "cjk": {
    "scan": [
      "SKILL.md",
      "CHANGELOG.md",
      "references/**/*.md",
      "demo-math.html",
      "examples/*.html"
    ],
    "require_charset": [
      "demo-math.html",
      "examples/*.html"
    ]
  },
  "prose": {
    "files": [
      ".github/workflows/ci.yml",
      "scripts/git-pre-commit.sh"
    ],
    "count_regex": "\\b(?:one|two|three|four|five|six|seven|eight|nine|ten|\\d+)\\s+checks?\\b"
  },
  "shared": [
    {
      "path": "references/design-judgment.md",
      "sha256": "fce284d7137d0ec8499a01f65aa8771aeadf55d07954822255b7695a6a206cdc"
    }
  ]
}
